# Local (docker compose up -d db):
DATABASE_URL="postgresql://mess:mess@localhost:5433/mess"
# Production: any Postgres, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mess?sslmode=require"
# Optional pool cap (set 1 only for `prisma dev`'s single-connection Postgres)
# DATABASE_POOL_MAX=1

# Public URL of the app (OAuth redirect). Locally: http://localhost:3000
APP_URL="http://localhost:3000"

# ── Google Drive backup (optional; card shows "not set up" without these) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 32 random bytes, base64:  openssl rand -base64 32   (encrypts refresh tokens; never change without re-connecting)
TOKEN_ENCRYPTION_KEY=""
# Protects /api/cron/drive-backup (min 16 chars):  openssl rand -hex 24
CRON_SECRET=""

# ── Android app (Trusted Web Activity via PWABuilder / Bubblewrap) ──
# Served at /.well-known/assetlinks.json so the app opens without a URL bar.
# Comma-separate several fingerprints (upload key + Play App Signing key).
ANDROID_PACKAGE_NAME=""
ANDROID_CERT_SHA256=""
