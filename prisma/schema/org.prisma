// ───────────── Tenant: a mess (Org), its staff (Member) and staff invites ─────────────

enum Role {
  owner
  manager
  delivery
}

model Org {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  phone            String?
  upiId            String?
  brandColor       String            @default("#ea580c")
  /// A meal on day D can be skipped until (D - 1) at this local hour.
  skipCutoffHour   Int               @default(21) @db.SmallInt
  timezone         String            @default("Asia/Kolkata")
  /// Owner's wastage goal, % of food cooked.
  wastageTargetPct Int               @default(5) @db.SmallInt
  createdAt        DateTime          @default(now())
  members          Member[]
  plans            Plan[]
  customers        Customer[]
  holidays         Holiday[]
  skips            Skip[]
  deliveries       Delivery[]
  payments         Payment[]
  dishes           Dish[]
  wastageEntries   WastageEntry[]
  driveConnections DriveConnection[]
  invites          Invite[]
}

model Member {
  orgId     String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
}

/// Owner's invite for a staff member (manager / delivery), shared as a link
/// (/join/<token>) on WhatsApp. Only the invited phone can accept; accepting
/// creates the Member row and deletes the invite.
model Invite {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  /// 10-digit mobile; the account that accepts must have this phone.
  phone     String
  role      Role
  /// Secret in the link (like Customer.portalToken). Not exported.
  token     String   @unique
  createdBy String?  @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One open invite per phone per mess (re-inviting replaces it).
  @@unique([orgId, phone])
  @@index([orgId])
}
