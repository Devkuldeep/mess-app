// ───────────── Auth: accounts and login sessions ─────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String    @unique // 10-digit Indian mobile, digits only
  name            String
  passwordHash    String
  /// When the user accepted the Terms & Privacy Policy, and which version (DPDP consent record).
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  sessions        Session[]
  memberships     Member[]
}

model Session {
  id        String   @id // sha256 of the cookie token; raw token never stored
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
