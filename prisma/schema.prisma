// Mess app — multi-tenant schema.
// Every tenant-owned table has `orgId`. Server code must always filter by the
// orgId from the signed-in member's context (see src/server/auth.ts), never by
// an orgId sent from the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  manager
  delivery
}

enum Meal {
  lunch
  dinner
}

enum MealPlan {
  lunch
  dinner
  both
}

enum Diet {
  veg
  nonveg
}

enum PayMethod {
  upi
  cash
  other
}

enum DishUnit {
  kg
  litre
  count
}

enum WasteReason {
  none
  late_skip // customers skipped after cooking started
  not_taken // customer didn't take the tiffin
  disliked // food not liked
  overcooked // simply made too much
  other
}

// ───────────── Auth ─────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String    @unique // 10-digit Indian mobile, digits only
  name            String
  passwordHash    String
  /// When the user accepted the Terms & Privacy Policy, and which version (DPDP consent record).
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  sessions        Session[]
  memberships     Member[]
}

model Session {
  id        String   @id // sha256 of the cookie token; raw token never stored
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────── Tenant ─────────────

model Org {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  phone            String?
  upiId            String?
  brandColor       String            @default("#ea580c")
  /// A meal on day D can be skipped until (D - 1) at this local hour.
  skipCutoffHour   Int               @default(21) @db.SmallInt
  timezone         String            @default("Asia/Kolkata")
  /// Owner's wastage goal, % of food cooked.
  wastageTargetPct Int               @default(5) @db.SmallInt
  createdAt        DateTime          @default(now())
  members          Member[]
  plans            Plan[]
  customers        Customer[]
  holidays         Holiday[]
  skips            Skip[]
  deliveries       Delivery[]
  payments         Payment[]
  dishes           Dish[]
  wastageEntries   WastageEntry[]
  driveConnections DriveConnection[]
}

model Member {
  orgId     String   @db.Uuid
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
}

model Plan {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @db.Uuid
  name         String
  meals        MealPlan
  pricePerMeal Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  org          Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customers    Customer[]

  @@unique([orgId, id])
}

model Customer {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @db.Uuid
  name        String
  phone       String?
  address     String?
  area        String?
  planId      String?    @db.Uuid
  diet        Diet       @default(veg)
  notes       String?
  startDate   DateTime   @db.Date
  endDate     DateTime?  @db.Date
  /// Secret for the customer's no-login link (/c/<token>).
  portalToken String     @unique
  createdAt   DateTime   @default(now())
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Composite FK: the plan must belong to the same org.
  plan        Plan?      @relation(fields: [orgId, planId], references: [orgId, id], onDelete: NoAction)
  skips       Skip[]
  deliveries  Delivery[]
  payments    Payment[]

  @@unique([orgId, id])
  @@index([orgId])
}

model Skip {
  orgId      String   @db.Uuid
  customerId String   @db.Uuid
  date       DateTime @db.Date
  meal       Meal
  byCustomer Boolean  @default(false)
  createdAt  DateTime @default(now())
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Cascade)

  @@id([customerId, date, meal])
  @@index([orgId, date])
}

model Holiday {
  orgId  String   @db.Uuid
  date   DateTime @db.Date
  reason String?
  org    Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, date])
}

model Delivery {
  orgId       String   @db.Uuid
  customerId  String   @db.Uuid
  date        DateTime @db.Date
  meal        Meal
  deliveredAt DateTime @default(now())
  deliveredBy String?  @db.Uuid
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Cascade)

  @@id([customerId, date, meal])
  @@index([orgId, date])
}

model Payment {
  /// Generated on the device, so an offline payment replayed twice is stored once.
  id         String    @id @db.Uuid
  orgId      String    @db.Uuid
  customerId String    @db.Uuid
  amount     Decimal   @db.Decimal(10, 2)
  paidOn     DateTime  @db.Date
  method     PayMethod @default(upi)
  note       String?
  createdBy  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, customerId])
}

// ───────────── Wastage ─────────────

/// Something the kitchen cooks and measures daily (Dal, Chawal, Sabzi, Roti…).
model Dish {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @db.Uuid
  name        String
  unit        DishUnit
  /// Starting guess for quantity per tiffin, until real data is learned.
  perTiffin   Decimal       @db.Decimal(8, 3)
  /// ₹ per unit (kg / litre / piece). Optional; enables ₹ loss.
  costPerUnit Decimal?      @db.Decimal(10, 2)
  /// Changes daily (which sabzi / which dal) → entry asks for a label.
  variety     Boolean       @default(false)
  sortOrder   Int           @default(0)
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  org         Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items       WastageItem[]

  @@unique([orgId, name])
  @@unique([orgId, id])
  @@index([orgId])
}

/// One meal's "kitna bana / kitna bacha" record. One per org + date + meal.
model WastageEntry {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @db.Uuid
  date      DateTime      @db.Date
  meal      Meal
  /// Tiffins scheduled when saved (snapshot, so history doesn't shift).
  tiffins   Int
  reason    WasteReason   @default(none)
  note      String?
  createdBy String?       @db.Uuid
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  org       Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items     WastageItem[]

  @@unique([orgId, date, meal])
  @@unique([orgId, id])
  @@index([orgId, date])
}

model WastageItem {
  orgId       String       @db.Uuid
  entryId     String       @db.Uuid
  dishId      String       @db.Uuid
  /// Today's variety, e.g. "Bhindi" for Sabzi.
  label       String?
  cooked      Decimal      @db.Decimal(10, 3)
  leftover    Decimal      @db.Decimal(10, 3)
  /// Dish cost when saved (snapshot, so price changes don't rewrite history).
  costPerUnit Decimal?     @db.Decimal(10, 2)
  entry       WastageEntry @relation(fields: [orgId, entryId], references: [orgId, id], onDelete: Cascade)
  dish        Dish         @relation(fields: [orgId, dishId], references: [orgId, id], onDelete: Restrict)

  @@id([entryId, dishId])
  @@index([orgId, dishId])
}

// ───────────── Google Drive backup ─────────────

enum DriveStatus {
  active
  needs_reconnect // owner revoked access or the token expired
}

/// A mess owner's own Google Drive, used for automatic backups (drive.file scope).
model DriveConnection {
  orgId           String      @id @db.Uuid
  googleEmail     String?
  /// AES-256-GCM encrypted refresh token (src/server/secretbox.ts). Never exported or logged.
  refreshTokenEnc String
  /// "Mess Manager Backups" folder created by the app.
  folderId        String?
  status          DriveStatus @default(active)
  connectedBy     String?     @db.Uuid
  connectedAt     DateTime    @default(now())
  lastAttemptAt   DateTime?
  lastBackupAt    DateTime?
  lastBackupName  String?
  lastError       String?
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
